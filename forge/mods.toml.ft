#set ( $d = "$" )
modLoader = "javafml"
loaderVersion = "[40,)"
#issueTrackerURL = ""
license = "${d}{mod_license}"

[[mods]]
modId = "${d}{mod_id}"
version = "${d}{mod_version}"
displayName = "${d}{mod_name}"
authors = "${d}{mod_authors}"
description = '''
${d}{mod_description}
'''
logoFile = "icon.png"

[[dependencies.${d}{mod_id}]]
modId = "forge"
mandatory = true
versionRange = "[47,)"
ordering = "NONE"
side = "BOTH"

[[dependencies.${d}{mod_id}]]
modId = "minecraft"
mandatory = true
versionRange = "[1.20.1,)"
ordering = "NONE"
side = "BOTH"

[[dependencies.${d}{mod_id}]]
modId = "valkyrienskies"
mandatory = true
versionRange = "[2.4.0,)"
ordering = "AFTER"
side = "BOTH"