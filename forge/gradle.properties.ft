# Done to increase the memory available to Gradle.
org.gradle.jvmargs=-Xmx2G
org.gradle.parallel=true

# Meta dependency
kotlin_version=2.0.0

# Mod properties (mostly for the mods.toml metadata)
mod_version = 1.0.0
mod_id = ${MOD_ID}
mod_name = ${MOD_NAME}
mod_license = ${LICENSE.name}
mod_authors = ${AUTHORS}
mod_description = ${DESCRIPTION}

maven_group = ${BUILD_COORDS.groupId}
archives_base_name = ${MOD_ID}
enabled_platforms = forge
loom.platform = forge

# Minecraft properties
minecraft_version = 1.20.1

# Dependencies
forge_version = 47.4.10

# VS dependencies
vs2_version=2.4.0+7e18c81efc
vs_core_version=1.1.0+3434464932

# Kotlin platform dependencies
kotlin_forge=4.11.0
kotlin_fabric=1.11.0+kotlin.2.0.0

# Makes MDG use parchment
neoForge.parchment.minecraftVersion=1.20.1
neoForge.parchment.mappingsVersion=2023.09.03