$set ( $d = "$" )
modLoader = "javafml" #mandatory
loaderVersion = "${d}{forge_loader_version_range}" #mandatory This is typically bumped every Minecraft version by Forge. See https://files.minecraftforge.net/ for a list of versions.
license = "${d}{license}" # Review your options at https://choosealicense.com/.
#issueTrackerURL="https://change.me.to.your.issue.tracker.example.invalid/" #optional

[[mods]] #mandatory
modId = "${d}{mod_id}" #mandatory
version = "${d}{version}" #mandatory
displayName = "${d}{mod_name}" #mandatory
#updateJSONURL="https://change.me.example.invalid/updates.json" #optional (see https://mcforge.readthedocs.io/en/latest/gettingstarted/autoupdate/)
#displayURL="https://change.me.to.your.mods.homepage.example.invalid/" #optional (displayed in the mod UI)
logoFile = "icon.png" #optional (needs to be in the root of your mod jar (root of your 'resources' folder))
credits = "Thanks for this example mod goes to Java" #optional
authors = "${d}{mod_author}" #optional
description = '''${d}{description}''' #mandatory (Supports multiline text)

[[dependencies.${d}{mod_id}]] #optional
modId = "forge" #mandatory
mandatory = true #mandatory
versionRange = "[${d}{forge_version},)" #mandatory
ordering = "NONE" # The order that this dependency should load in relation to your mod, required to be either 'BEFORE' or 'AFTER' if the dependency is not mandatory
side = "BOTH" # Side this dependency is applied on - 'BOTH', 'CLIENT' or 'SERVER'
[[dependencies.${d}{mod_id}]]
modId = "minecraft"
mandatory = true
versionRange = "${d}{minecraft_version_range}"
ordering = "NONE"
side = "BOTH"

[[dependencies.${d}{mod_id}]]
modId = "valkyrienskies"
mandatory = true
versionRange = "[2.4.0,)"
ordering = "NONE"
side = "BOTH"
