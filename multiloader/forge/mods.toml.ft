#set ( $d = "$" )
#set ( $e = "#" )
modLoader = "javafml" ${e}mandatory
loaderVersion = "${d}{forge_loader_version_range}" ${e}mandatory This is typically bumped every Minecraft version by Forge. See https://files.minecraftforge.net/ for a list of versions.
license = "${d}{license}" ${e} Review your options at https://choosealicense.com/.
${e}issueTrackerURL="https://change.me.to.your.issue.tracker.example.invalid/" ${e}optional

[[mods]] ${e}mandatory
modId = "${d}{mod_id}" ${e}mandatory
version = "${d}{version}" ${e}mandatory
displayName = "${d}{mod_name}" ${e}mandatory
${e}updateJSONURL="https://change.me.example.invalid/updates.json" ${e}optional (see https://mcforge.readthedocs.io/en/latest/gettingstarted/autoupdate/)
${e}displayURL="https://change.me.to.your.mods.homepage.example.invalid/" ${e}optional (displayed in the mod UI)
logoFile = "icon.png" ${e}optional (needs to be in the root of your mod jar (root of your 'resources' folder))
credits = "Thanks for this example mod goes to Java" ${e}optional
authors = "${d}{mod_author}" ${e}optional
description = '''${d}{description}''' ${e}mandatory (Supports multiline text)

[[dependencies.${d}{mod_id}]] ${e}optional
modId = "forge" ${e}mandatory
mandatory = true ${e}mandatory
versionRange = "[${d}{forge_version},)" ${e}mandatory
ordering = "NONE" ${e} The order that this dependency should load in relation to your mod, required to be either 'BEFORE' or 'AFTER' if the dependency is not mandatory
side = "BOTH" ${e} Side this dependency is applied on - 'BOTH', 'CLIENT' or 'SERVER'
[[dependencies.${d}{mod_id}]]
modId = "minecraft"
mandatory = true
versionRange = "${d}{minecraft_version_range}"
ordering = "NONE"
side = "BOTH"

[[dependencies.${d}{mod_id}]]
modId = "valkyrienskies"
mandatory = true
versionRange = "[2.4.0,)"
ordering = "NONE"
side = "BOTH"
