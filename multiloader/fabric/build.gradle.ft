#set ( ${d} = "$" )
plugins {
    id 'multiloader-loader'
    id 'fabric-loom'
#if ( ${LANGUAGE} == 'Kotlin' )
    id 'org.jetbrains.kotlin.jvm'
#end
}
dependencies {
    minecraft "com.mojang:minecraft:${d}{minecraft_version}"
    mappings loom.layered {
        officialMojangMappings()
        parchment("org.parchmentmc.data:parchment-${d}{parchment_minecraft}:${d}{parchment_version}@zip")
    }
    modImplementation "net.fabricmc:fabric-loader:${d}{fabric_loader_version}"
    modImplementation "net.fabricmc.fabric-api:fabric-api:${d}{fabric_version}"
    implementation group: 'com.google.code.findbugs', name: 'jsr305', version: '3.0.1'
    implementation project(":common")

    // region VS dependency
    modImplementation("org.valkyrienskies:valkyrienskies-120-fabric:${d}{rootProject.vs2_version}") { transitive = false
        exclude group: 'org.valkyrienskies.core', module: ''
    }

    modImplementation "fuzs.forgeconfigapiport:forgeconfigapiport-fabric:${d}{rootProject.fcap_version}"
    modRuntimeOnly("maven.modrinth:forge-config-screens:v8.0.2-1.20.1-Fabric")
    modRuntimeOnly("maven.modrinth:modmenu:${d}{rootProject.modmenu_version}")

    implementation("org.valkyrienskies.core:api:${d}{rootProject.vs_core_version}") {
        exclude group: 'org.joml', module: ''
    }
    implementation("org.valkyrienskies.core:util:${d}{rootProject.vs_core_version}") {
        exclude group: 'org.joml', module: ''
    }
    implementation("org.valkyrienskies.core:internal:${d}{rootProject.vs_core_version}") {
        exclude group: 'org.joml', module: ''
    }
    implementation("org.joml:joml-primitives:1.10.0")
    implementation("org.joml:joml:1.10.4")
#if ( ${LANGUAGE} == 'Kotlin' )
    modImplementation("net.fabricmc:fabric-language-kotlin:${d}{rootProject.fabric_language_kotlin_version}")
    api "org.jetbrains.kotlin:kotlin-stdlib:2.0.0"
    api "org.jetbrains.kotlin:kotlin-reflect:2.0.0"
#end
    // endregion
}

loom {
    if (project(":common").file("src/main/resources/${d}{mod_id}.accesswidener").exists()) {
        accessWidenerPath.set(project(":common").file("src/main/resources/${d}{mod_id}.accesswidener"))
    }
    mixin {
        defaultRefmapName.set("${d}{mod_id}.refmap.json")
    }
    runs {
        client {
            client()
            setConfigName("Fabric Client")
            ideConfigGenerated(true)
            runDir("run")
        }
        server {
            server()
            setConfigName("Fabric Server")
            ideConfigGenerated(true)
            runDir("run")
        }
    }
}

#if ( ${LANGUAGE} == 'Kotlin' )
repositories {
    mavenCentral()
}
kotlin {
    jvmToolchain(17)
}
#end